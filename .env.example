# ===================================================================
# BLUE PEARL NEXA — SMTP EMAIL CONFIGURATION (NODEMAILER)
# ===================================================================
# 1. EMAIL_USER: Your full Gmail address (e.g. yourname@gmail.com)
# 2. EMAIL_PASS: The 16-character App Password generated from Google:
#    (Google Account -> Security -> 2-Step Verification -> App passwords)
# ===================================================================

EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-google-app-password

# Optional: Recipient email address (if omitted, messages are sent directly to EMAIL_USER)
# EMAIL_TO=your-email@gmail.com

